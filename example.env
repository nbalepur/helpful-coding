# VibeJam – copy to .env at project root, then: cd interface && npm run sync-env

# Required
OPENAI_API_KEY=
SECRET_KEY=
DATABASE_URL=postgresql://postgres:password@localhost:5432/helpful_coding
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/helpful_coding

# URLs (backend 4828, frontend 3000 by default)
BACKEND_URL=http://localhost:4828
NEXT_PUBLIC_BACKEND_URL=http://localhost:4828
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Contact (About page + password-reset emails)
FROM_CONTACT_EMAIL=
FROM_CONTACT_NAME=

# Password reset (Brevo)
BREVO_API_KEY=
RESET_LINK_BASE_URL=

# Function tasks: OneCompiler via RapidAPI, or set USE_LOCAL_EXECUTION=true for local Python (NOT RECOMMENDED)
RAPIDAPI_KEY=
USE_LOCAL_EXECUTION=false

# Agent (Aider + summary model)
AIDER_MODEL=gpt-4.1-2025-04-14
SUMMARY_MODEL=gpt-4.1-2025-04-14

# Frontend: allow submit after N seconds even if tests fail (default 600)
NEXT_PUBLIC_GIVE_UP_SECONDS=600

# CORS (comma-separated origins if not localhost)
# CORS_ORIGINS=

# Server-side only: Next.js API routes → backend (default 127.0.0.1:4828)
# BACKEND_INTERNAL_URL=http://127.0.0.1:4828
